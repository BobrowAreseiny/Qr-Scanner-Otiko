<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="QRScanner.App.Controls.AppToolbar"
             x:Name="Root"
             HeightRequest="40">

    <Grid BackgroundColor="{StaticResource Primary}"
          ColumnDefinitions="Auto,*,40"
          Padding="0">

        <Label Text="Назад"
               WidthRequest="84"
               FontSize="18"
               FontAttributes="Bold"
               TextColor="{StaticResource White}"
               HorizontalTextAlignment="Center"
               VerticalOptions="Center"
               SemanticProperties.Description="Назад"
               IsVisible="{Binding ShowBack, Source={x:Reference Root}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding BackCommand, Source={x:Reference Root}}" />
            </Label.GestureRecognizers>
        </Label>

        <Label Grid.Column="1"
               Text="{Binding Title, Source={x:Reference Root}}"
               Style="{StaticResource ToolbarTitleLabel}"
               Margin="8,0,0,0" />

        <Label Grid.Column="2"
               Text="⋮"
               Style="{StaticResource ToolbarIconLabel}"
               SemanticProperties.Description="Меню"
               IsVisible="{Binding ShowMenu, Source={x:Reference Root}}">
            <Label.GestureRecognizers>
                <TapGestureRecognizer Command="{Binding MenuCommand, Source={x:Reference Root}}" />
            </Label.GestureRecognizers>
        </Label>

    </Grid>
</ContentView>
