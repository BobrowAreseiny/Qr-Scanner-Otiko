<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.SettingsPage"
             Title="Настройки"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Настройки"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,0,16,32" Spacing="0">

                <Label Text="ЭЛЕКТРОННЫЙ ЗНАК (DATAMARK)"
                       Style="{StaticResource SectionHeaderLabel}" />

                <Label Text="Сервер" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="8,0"
                        Margin="0,0,0,10">
                    <Entry Text="{Binding Server, Mode=TwoWay}"
                           Placeholder="https://api.datamark.by/" />
                </Border>

                <Label Text="Логин" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="8,0"
                        Margin="0,0,0,10">
                    <Entry Text="{Binding Login, Mode=TwoWay}"
                           Placeholder="Логин Электронного знака" />
                </Border>

                <Label Text="Пароль" Style="{StaticResource SettingLabel}" Margin="0,0,0,4" />
                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="8,0"
                        Margin="0,0,0,10">
                    <Entry Text="{Binding Password, Mode=TwoWay}"
                           IsPassword="True"
                           Placeholder="Пароль Электронного знака" />
                </Border>

                <Button Text="Проверить подключение"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding TestCommand}" />

                <Button Text="Сохранить"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding SaveCommand}" />

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,10,0,0" />

                <Label Text="API: https://api.datamark.by/ · Личный кабинет: https://i.datamark.by/"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,6,0,0" />

                <Label Text="Логин и пароль можно изменить в любой момент. После смены пароля на сервере введите новый пароль и нажмите «Сохранить»."
                       Style="{StaticResource BodyLabel}"
                       Margin="0,6,0,0" />

                <Label Text="Пробелы в начале и конце логина и пароля игнорируются."
                       Style="{StaticResource BodyLabel}"
                       Margin="0,4,0,0" />

                <Label Text="Требования к паролю: не менее 8 символов, заглавная латинская буква, цифра и спецсимвол."
                       Style="{StaticResource BodyLabel}"
                       Margin="0,4,0,0" />

                <Label Text="Логин и пароль хранятся только в защищённом хранилище Android и не записываются в логи."
                       Style="{StaticResource BodyLabel}"
                       Margin="0,4,0,0" />

                <Label Text="1С"
                       Style="{StaticResource SectionHeaderLabel}" />

                <Label Text="Обмен заказами по HTTP API."
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Настройки подключения"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding OpenOneCSettingsCommand}" />

                <Label Text="БЕЗОПАСНОСТЬ"
                       Style="{StaticResource SectionHeaderLabel}" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <Label Text="Шифрование БД" Style="{StaticResource SettingLabel}" />
                    <Label Grid.Column="1"
                           Text="SQLCipher"
                           Style="{StaticResource SettingValueLabel}" />
                </Grid>

                <BoxView Style="{StaticResource SettingRowSeparator}" />

                <Label Text="Код восстановления"
                       Style="{StaticResource SettingLabel}"
                       Margin="0,14,0,8" />

                <Grid ColumnDefinitions="*,*,*" ColumnSpacing="6">
                    <Button Text="Показать"
                            Style="{StaticResource SmallButtonStyle}"
                            Command="{Binding ShowRecoveryCodeCommand}" />

                    <Button Grid.Column="1"
                            Text="Копировать"
                            Style="{StaticResource SmallButtonStyle}"
                            Command="{Binding CopyRecoveryCodeCommand}" />

                    <Button Grid.Column="2"
                            Text="В файл"
                            Style="{StaticResource SmallButtonStyle}"
                            Command="{Binding SaveRecoveryCodeCommand}" />
                </Grid>

                <Label Text="{Binding RecoveryCode}"
                       IsVisible="{Binding IsRecoveryCodeVisible}"
                       FontSize="12"
                       TextColor="{StaticResource TextPrimary}"
                       LineBreakMode="CharacterWrap"
                       Margin="0,8,0,0" />

                <Label Text="{Binding RecoveryStatusMessage}"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,6,0,0" />

                <BoxView Style="{StaticResource SettingRowSeparator}" Margin="0,14,0,0" />

                <Label Text="Резервные копии"
                       Style="{StaticResource SettingLabel}"
                       Margin="0,14,0,4" />

                <Label Text="{Binding LastBackupText}"
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Создать копию БД"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding CreateBackupCommand}" />

                <Button Text="Сохранить копию в файл"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding SaveBackupCommand}" />

                <Button Text="Восстановить из файла"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding RestoreBackupCommand}" />

                <Label Text="{Binding BackupStatusMessage}"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,6,0,0" />

                <BoxView Style="{StaticResource SettingRowSeparator}" Margin="0,14,0,0" />

                <Label Text="ПЕРЕНОС СТАРОЙ БАЗЫ"
                       Style="{StaticResource SectionHeaderLabel}" />

                <Label Text="Выберите файл barcode.db старого приложения. Короба и марки будут добавлены в новую зашифрованную базу. Импорт выполняется только в пустую базу."
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Импортировать старую базу"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="40"
                        Margin="0,8,0,0"
                        Command="{Binding ImportLegacyDatabaseCommand}" />

                <Label Text="{Binding LegacyImportStatusMessage}"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,6,0,0" />

                <BoxView Style="{StaticResource SettingRowSeparator}" Margin="0,14,0,0" />

                <Label Text="О ПРОГРАММЕ"
                       Style="{StaticResource SectionHeaderLabel}" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <Label Text="Версия" Style="{StaticResource SettingLabel}" />
                    <Label Grid.Column="1"
                           Text="1.0.0"
                           Style="{StaticResource SettingValueLabel}" />
                </Grid>

                <BoxView Style="{StaticResource SettingRowSeparator}" />

                <Grid ColumnDefinitions="*,Auto" Padding="0,14">
                    <Grid.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding ShowAboutCommand}" />
                    </Grid.GestureRecognizers>
                    <Label Text="О программе" Style="{StaticResource SettingLabel}" />
                    <Label Grid.Column="1"
                           Text="›"
                           Style="{StaticResource SettingValueLabel}"
                           FontSize="22" />
                </Grid>

                <BoxView Style="{StaticResource SettingRowSeparator}" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
