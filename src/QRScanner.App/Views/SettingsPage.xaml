<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.SettingsPage"
             Title="Настройки"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Настройки"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <Label Text="РАЗДЕЛЫ"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto,Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Электронный знак Datamark">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="datamark" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_datamark.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Datamark"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="{Binding DatamarkSummaryText}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Обмен с 1С">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOneCSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_1c.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="1С"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Обмен заказами"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Компьютер SMB">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="smb" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_send.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Компьютер"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="{Binding SmbSummaryText}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Обновление приложения">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="update" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_update.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Обновление"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="{Binding CurrentVersionText}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Безопасность и код восстановления">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="security" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_security.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Защита"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Код восстановления"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="2"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Резервные копии">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="backups" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_backup.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Копии"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="{Binding BackupSummaryText}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Файлы и очистка">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="files" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_files.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Файлы"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Очистка старых файлов"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="3"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Перенос старой базы">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                                  CommandParameter="legacy" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="settings_legacy.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Перенос"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Импорт barcode.db"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </Grid>

                <Border Style="{StaticResource CardStyle}"
                        Padding="14"
                        Margin="0">
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Command="{Binding OpenSectionCommand}"
                                              CommandParameter="about" />
                    </Border.GestureRecognizers>
                    <Grid ColumnDefinitions="Auto,*,Auto"
                          ColumnSpacing="12"
                          MinimumHeightRequest="64">
                        <Image Source="settings_about.svg"
                               WidthRequest="36"
                               HeightRequest="36"
                               VerticalOptions="Center"
                               Aspect="AspectFit" />
                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2"
                                             VerticalOptions="Center">
                            <Label Text="О программе"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Text="{Binding CurrentVersionText}"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}" />
                        </VerticalStackLayout>
                        <Label Grid.Column="2"
                               Text="›"
                               FontSize="24"
                               TextColor="{StaticResource TextSecondary}"
                               VerticalOptions="Center" />
                    </Grid>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
