<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.ShipmentPage"
             Title="Отгрузка"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Отгрузка"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <Label Text="ВЫБЕРИТЕ ДЕЙСТВИЕ"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <Border Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="170"
                            SemanticProperties.Description="Новый заказ">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenOrderCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_ship.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Новый заказ"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Сканирование и файл"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="170"
                            SemanticProperties.Description="История заказов">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_history.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="История"
                                   FontSize="18"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Прошлые заказы"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
