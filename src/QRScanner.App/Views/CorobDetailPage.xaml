<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.CorobDetailPage"
             x:Name="Root"
             Title="Короб"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="{Binding Title}"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <CollectionView Grid.Row="2"
                        x:Name="MarksList"
                        ItemsSource="{Binding Barcodes}"
                        SelectionMode="None"
                        ItemSizingStrategy="MeasureFirstItem"
                        VerticalScrollBarVisibility="Never"
                        Margin="8,0,8,0">
            <CollectionView.Header>
                <VerticalStackLayout Padding="8,8,8,8" Spacing="8">

                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                        <Label Text="{Binding CorobName}"
                               FontSize="20"
                               FontAttributes="Bold"
                               LineBreakMode="WordWrap"
                               VerticalOptions="Center" />
                        <Button Grid.Column="1"
                                Text="Изменить"
                                Style="{StaticResource SmallButtonStyle}"
                                HeightRequest="40"
                                MinimumHeightRequest="40"
                                Command="{Binding EditNameCommand}" />
                    </Grid>

                    <Label Text="{Binding CountText}"
                           Style="{StaticResource BodyLabel}" />

                    <BoxView Style="{StaticResource SettingRowSeparator}" />

                    <Label Text="Марки"
                           Style="{StaticResource SectionHeaderLabel}"
                           Margin="0,0,0,0" />

                    <Label Text="{Binding StatusMessage}"
                           Style="{StaticResource BodyLabel}" />

                    <Button Text="Войти в настройки"
                            Style="{StaticResource MenuButtonStyle}"
                            HeightRequest="48"
                            Margin="0,6,0,0"
                            IsVisible="{Binding IsAuthRequired}"
                            Command="{Binding OpenSettingsCommand}" />
                </VerticalStackLayout>
            </CollectionView.Header>

            <CollectionView.EmptyView>
                <Label Text="Марок пока нет."
                       Style="{StaticResource BodyLabel}"
                       Margin="8,24,8,8" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Style="{StaticResource CardStyle}"
                            Margin="0,0,0,10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding DisplayTitle}"
                                       Style="{StaticResource ListNameLabel}" />
                                <Label Text="{Binding ProductDetails}"
                                       Style="{StaticResource ListMetaLabel}"
                                       MaxLines="1"
                                       LineBreakMode="TailTruncation" />
                            </VerticalStackLayout>

                            <Button Grid.Column="1"
                                    Text="🗑"
                                    WidthRequest="48"
                                    MinimumWidthRequest="48"
                                    FontSize="22"
                                    Style="{StaticResource SmallDangerButtonStyle}"
                                    SemanticProperties.Description="Удалить марку"
                                    Command="{Binding Path=BindingContext.DeleteBarcodeCommand, Source={x:Reference Root}}"
                                    CommandParameter="{Binding}" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Grid Grid.Row="3"
              Padding="8,4,8,12"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              BackgroundColor="{StaticResource Background}">
            <Button Text="Сохранить"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding SaveCommand}" />

            <Button Grid.Column="1"
                    Text="QR"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding QrMenuCommand}" />

            <Button Grid.Column="2"
                    Text="Назад"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding BackCommand}" />
        </Grid>

    </Grid>

</ContentPage>
