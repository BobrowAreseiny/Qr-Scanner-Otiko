<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.CorobDetailPage"
             x:Name="Root"
             Title="Короб"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="{Binding Title}"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2" x:Name="ContentScroll">
            <VerticalStackLayout Padding="16,8,16,12" Spacing="8">

                <Label Text="Название"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="8,0">
                    <Entry Text="{Binding Corob.Name, Mode=TwoWay}"
                           HeightRequest="44"
                           Placeholder="Название короба" />
                </Border>

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Ёмкость"
                           Style="{StaticResource SettingLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding CountText}"
                           Style="{StaticResource SettingValueLabel}" />
                </Grid>

                <BoxView Style="{StaticResource SettingRowSeparator}" />

                <Label Text="Марки"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Войти в настройки"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="48"
                        Margin="0,6,0,0"
                        IsVisible="{Binding IsAuthRequired}"
                        Command="{Binding OpenSettingsCommand}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Barcodes}"
                                     Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayTitle}"
                                               Style="{StaticResource ListNameLabel}" />
                                        <Label Text="{Binding ProductDetails}"
                                               Style="{StaticResource ListMetaLabel}" />
                                    </VerticalStackLayout>

                                    <Button Grid.Column="1"
                                            Text="✕"
                                            WidthRequest="48"
                                            MinimumWidthRequest="48"
                                            FontSize="22"
                                            Style="{StaticResource SmallDangerButtonStyle}"
                                            SemanticProperties.Description="Удалить марку"
                                            Command="{Binding Path=BindingContext.DeleteBarcodeCommand, Source={x:Reference Root}}"
                                            CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3"
                             Padding="0,4,0,12"
                             Spacing="8"
                             BackgroundColor="{StaticResource Background}">
            <Button Text="1. Сохранить"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Command="{Binding SaveCommand}" />

            <Button Text="2. QR"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Margin="7,0"
                    Command="{Binding QrMenuCommand}" />

            <Button Text="0. Назад"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Margin="7,0"
                    Command="{Binding BackCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
