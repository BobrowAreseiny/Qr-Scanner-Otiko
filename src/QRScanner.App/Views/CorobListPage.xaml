<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.CorobListPage"
             Title="Короба"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Короба"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <Grid Grid.Row="2">
            <CollectionView x:Name="corobs"
                            ItemsSource="{Binding Corobs}"
                            SelectionMode="None"
                            VerticalScrollBarVisibility="Never"
                            Margin="8,12,8,8">
                <CollectionView.Header>
                    <Label Text="Нажмите на короб, чтобы открыть."
                           Style="{StaticResource BodyLabel}"
                           Margin="8,0,8,8" />
                </CollectionView.Header>
                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <Border Style="{StaticResource CardStyle}">
                            <Grid ColumnDefinitions="*,Auto"
                                  ColumnSpacing="8">

                                <Grid Grid.Column="0"
                                      ColumnDefinitions="*,Auto"
                                      BackgroundColor="Transparent">
                                    <Grid.GestureRecognizers>
                                        <TapGestureRecognizer
                                            Command="{Binding Path=BindingContext.OpenCommand, Source={x:Reference corobs}}"
                                            CommandParameter="{Binding}" />
                                    </Grid.GestureRecognizers>

                                    <VerticalStackLayout Spacing="2"
                                                         VerticalOptions="Center">
                                        <Label Text="{Binding Name}"
                                               Style="{StaticResource ListNameLabel}" />
                                        <HorizontalStackLayout Spacing="10">
                                            <Label Text="{Binding CountText}"
                                                   Style="{StaticResource ListMetaLabel}" />
                                            <Label Text="{Binding StatusText}"
                                                   Style="{StaticResource ListMetaLabel}" />
                                        </HorizontalStackLayout>
                                    </VerticalStackLayout>

                                    <Label Grid.Column="1"
                                           Text="›"
                                           FontSize="28"
                                           TextColor="{StaticResource Primary}"
                                           VerticalOptions="Center"
                                           Margin="8,0,0,0" />
                                </Grid>

                                <Button Grid.Column="1"
                                        Text="🗑"
                                        WidthRequest="48"
                                        HeightRequest="44"
                                        MinimumWidthRequest="48"
                                        Padding="0"
                                        FontSize="22"
                                        Style="{StaticResource SmallDangerButtonStyle}"
                                        SemanticProperties.Description="Удалить короб"
                                        Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference corobs}}"
                                        CommandParameter="{Binding}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <Label Text="Пока нет коробов"
                   Style="{StaticResource BodyLabel}"
                   HorizontalOptions="Center"
                   VerticalOptions="Center"
                   IsVisible="{Binding IsEmpty}" />

            <ActivityIndicator IsRunning="{Binding IsBusy}"
                               IsVisible="{Binding IsBusy}"
                               Color="{StaticResource Primary}"
                               HorizontalOptions="Center"
                               VerticalOptions="Center" />
        </Grid>

        <VerticalStackLayout Grid.Row="3"
                             Padding="0,4,0,12"
                             Spacing="8"
                             BackgroundColor="{StaticResource Background}">
            <Button Text="1. Создать короб"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Command="{Binding CreateCommand}" />
            <Button Text="0. Назад"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Margin="7,0"
                    Command="{Binding BackCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
