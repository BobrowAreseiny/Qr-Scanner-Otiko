<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.HomePage"
             Title="Сканер QR"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Сканер QR"
                             ShowMenu="True"
                             MenuCommand="{Binding ShowMenuCommand}" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <Label Text="ВЫБЕРИТЕ РАЗДЕЛ"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Grid ColumnDefinitions="*,*"
                      RowDefinitions="Auto,Auto"
                      ColumnSpacing="12"
                      RowSpacing="12">

                    <Border Grid.Row="0"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Агрегация">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenAggregationCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_scan.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Агрегация"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Короба и сканирование"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="0"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Отгрузка">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenShipmentCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_ship.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Отгрузка"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Заказы и отправка"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="0"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="История заказов">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenHistoryCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_history.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="История"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Прошлые заказы"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>

                    <Border Grid.Row="1"
                            Grid.Column="1"
                            Style="{StaticResource CardStyle}"
                            Padding="14"
                            Margin="0"
                            MinimumHeightRequest="150"
                            SemanticProperties.Description="Настройки">
                        <Border.GestureRecognizers>
                            <TapGestureRecognizer Command="{Binding OpenSettingsCommand}" />
                        </Border.GestureRecognizers>
                        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="6">
                            <Image Source="home_settings.svg"
                                   WidthRequest="36"
                                   HeightRequest="36"
                                   HorizontalOptions="Start"
                                   Aspect="AspectFit" />
                            <Label Grid.Row="1"
                                   Text="Настройки"
                                   FontSize="20"
                                   FontAttributes="Bold" />
                            <Label Grid.Row="2"
                                   Text="Datamark, 1С, копии"
                                   FontSize="14"
                                   TextColor="{StaticResource TextSecondary}"
                                   LineBreakMode="WordWrap" />
                        </Grid>
                    </Border>
                </Grid>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
