<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.HomePage"
             Title="Сканер QR"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,Auto,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Сканер QR"
                             ShowMenu="True"
                             MenuCommand="{Binding ShowMenuCommand}" />

        <controls:MenuHeader Grid.Row="1"
                             Title="УЧЁТ КОРОБОВ" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="0,30,0,0" Spacing="40">

                <Button Text="1. Агрегация"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenAggregationCommand}" />

                <Button Text="2. Отгрузка"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenShipmentCommand}" />

                <BoxView Style="{StaticResource ThinDivider}"
                         Margin="0,7,0,0" />

                <Button Text="0. Выход"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="7,37,7,0"
                        Command="{Binding ExitCommand}" />

                <BoxView HeightRequest="60" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
