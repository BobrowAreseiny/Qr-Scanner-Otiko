<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.OrderHistoryPage"
             Title="История заказов"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="История заказов"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <Grid Grid.Row="2"
              RowDefinitions="Auto,*">

            <Label Grid.Row="0"
                   Text="{Binding StatusMessage}"
                   Style="{StaticResource BodyLabel}"
                   Padding="16,8" />

            <Grid Grid.Row="1">
                <CollectionView x:Name="orders"
                                ItemsSource="{Binding Orders}"
                                SelectionMode="None"
                                VerticalScrollBarVisibility="Never"
                                Margin="8,0,8,8">
                    <CollectionView.Header>
                        <Label Text="Нажмите на заказ, чтобы открыть."
                               Style="{StaticResource BodyLabel}"
                               Margin="8,0,8,8" />
                    </CollectionView.Header>
                    <CollectionView.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto"
                                      ColumnSpacing="8">

                                    <Grid Grid.Column="0"
                                          ColumnDefinitions="*,Auto"
                                          BackgroundColor="Transparent">
                                        <Grid.GestureRecognizers>
                                            <TapGestureRecognizer
                                                Command="{Binding Path=BindingContext.OpenCommand, Source={x:Reference orders}}"
                                                CommandParameter="{Binding}" />
                                        </Grid.GestureRecognizers>

                                        <VerticalStackLayout Spacing="2"
                                                             VerticalOptions="Center">
                                            <Label Text="{Binding Name}"
                                                   Style="{StaticResource ListNameLabel}" />
                                            <Label Text="{Binding DateText}"
                                                   Style="{StaticResource ListMetaLabel}" />
                                            <HorizontalStackLayout Spacing="10">
                                                <Label Text="{Binding CountText}"
                                                       Style="{StaticResource ListMetaLabel}" />
                                                <Label Text="{Binding StatusText}"
                                                       Style="{StaticResource ListMetaLabel}" />
                                            </HorizontalStackLayout>
                                            <Label Text="{Binding OneCStatusText}"
                                                   Style="{StaticResource ListMetaLabel}" />
                                        </VerticalStackLayout>

                                        <Label Grid.Column="1"
                                               Text="›"
                                               FontSize="28"
                                               TextColor="{StaticResource Primary}"
                                               VerticalOptions="Center"
                                               Margin="8,0,0,0" />
                                    </Grid>

                                    <ImageButton Grid.Column="1"
                                                 Source="trash.svg"
                                                 Style="{StaticResource SubtleImageButtonStyle}"
                                                 SemanticProperties.Description="Удалить заказ"
                                                 Command="{Binding Path=BindingContext.DeleteCommand, Source={x:Reference orders}}"
                                                 CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <Label Text="Заказы отсутствуют"
                       Style="{StaticResource BodyLabel}"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       IsVisible="{Binding IsEmpty}" />

                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                   IsVisible="{Binding IsBusy}"
                                   Color="{StaticResource Primary}"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>
        </Grid>

        <VerticalStackLayout Grid.Row="3"
                             Padding="0,4,0,12"
                             Spacing="8"
                             BackgroundColor="{StaticResource Background}">
            <Button Text="Назад"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Margin="7,0"
                    Command="{Binding BackCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
