<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.HelpPage"
             Title="Справка"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Справка"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="СКАНЕР QR"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="Учёт коробов и марок, отгрузка заказов, обмен с 1С и передача файлов на компьютер."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Работа выполняется сканером ТСД и клавишами 1–4, 0."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ГЛАВНЫЙ ЭКРАН"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="Четыре плитки: «Агрегация», «Отгрузка», «Отправка» и «Настройки». Нажмите на плитку, чтобы открыть раздел или отправить файлы."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Внизу — «Справка» и «Выход». Верхнее меню ⋮: «Логи», «О программе»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="1 — Агрегация, 2 — Отгрузка, 3 — Отправка на компьютер, 4 — Настройки, 0 — Выход."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="КЛАВИШИ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="1 — основное действие: сохранить, удалить марку, отгрузить заказ."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="2 — дополнительное действие: QR-код короба или возврат заказа на склад."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="3 — отправка файлов на компьютер. История заказов находится в разделе «Отгрузка»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="4 — настройки. 0 — назад или выход."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="В полях ввода клавиши работают как обычные цифры и буквы. Сканер срабатывает на любом экране."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="АГРЕГАЦИЯ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />

                        <Label Text="Создать короб"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Укажите название и ёмкость: «Стандарт» без ограничения или 12, 10, 5, 3 марки. Сканируйте марки и нажмите «Сохранить»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Одна марка — только в одном коробе. Дубли и переполнение блокируются. При сканировании марки из другого короба приложение покажет его номер, статус, заказ и данные товара."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Короба"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Нажмите на карточку, чтобы открыть состав. Корзина удаляет короб вместе с марками. Длинные названия переносятся."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Поиск"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Отсканируйте марку — приложение найдёт короб и покажет данные. Клавиша 1 удаляет марку."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ОТГРУЗКА"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />

                        <Label Text="Новый заказ"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Сканируйте короб — добавятся все его марки. Можно добавлять отдельные марки: смешанный заказ разрешён. Дубли проверяются автоматически."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="При сохранении создаётся .txt в Download/Otiko/Заказы. Если настроена 1С, заказ отправляется сразу; при ошибке остаётся в очереди."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="История заказов"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Показываются дата, количество марок, статус склада и статус 1С. В карточке заказа: «Отгрузить», «Вернуть», «Экспорт файла»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="«Вернуть» снимает статус отправки с коробов. Удаление заказа не удаляет короба и марки."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ПЕРЕДАЧА НА КОМПЬЮТЕР"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="На главном экране плитка «Отправка». Она проверяет QR всех коробов, создаёт отсутствующие и отправляет очередь."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Отправка выполняется только по кнопке, когда ТСД в сети склада. Мобильный интернет не используется; файлы остаются в очереди."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Заказы уходят в C:\QRScanner\Заказы, QR-коды — в C:\QRScanner\QR-коды."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Если файл с таким именем уже есть на компьютере, он не отправляется повторно и не перезаписывается."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="После отправки заказ остаётся в истории. Удалить его можно вручную корзиной в «Истории»; короба и марки сохраняются."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="QR-КОД КОРОБА"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="На экране короба нажмите «QR». PNG сразу сохраняется на ТСД в Download/Otiko/QR-коды; подпись с названием добавляется снизу."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Длинное название переносится до трёх строк и при необходимости сокращается. Кнопка отправки на компьютере проверит QR всех коробов и создаст недостающие."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="НАСТРОЙКИ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />

                        <Label Text="Разделы открываются плитками, как на главном экране: Datamark, 1С, Компьютер, Обновление, Защита, Копии, Файлы, Перенос, О программе."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Электронный знак (Datamark)"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Сервер, логин и пароль вводятся один раз. При следующих запусках приложение входит автоматически и обновляет сессию. Пароль можно показать переключателем."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="1С"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Адрес API, пути отправки и проверки, склад, таймаут и авторизация. «Проверить подключение» проверяет связь, «Отправить ожидающие заказы» повторяет отправку."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="Компьютер (SMB)"
                               Style="{StaticResource ListNameLabel}" />
                        <Label Text="Сервер — имя компьютера (например, BEAVER-JR) или IP. Быстрая настройка: запустите QRScannerSetup.exe на компьютере и нажмите на ТСД «Сканировать QR настроек». Запасной вариант — импорт QRScanner-access.txt из Download или папки приложения."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ФАЙЛЫ И ФОРМАТ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="На ТСД: заказы — Download/Otiko/Заказы, QR — Download/Otiko/QR-коды. На компьютере: C:\QRScanner\Заказы и C:\QRScanner\QR-коды."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Заказ .txt: одна полная марка на строку, UTF-8 без BOM, LF. Внутренние GS-разделители сохраняются, служебный символ «è» в начало не добавляется."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="В настройках есть очистка старых .txt и .png старше 30 дней. Короба, марки и заказы не затрагиваются."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="«Настройки» → «Обновление приложения» → «Проверить обновление»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="На компьютере в C:\QRScanner\Обновления лежат version.json и APK. Приложение скачает файл по SMB и откроет установщик Android — нажмите «Обновить»."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="База, короба, заказы и настройки сохраняются. Один раз нужно разрешить установку приложений из этого источника."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="БЕЗОПАСНОСТЬ И ДАННЫЕ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="Локальная база шифруется SQLCipher. PIN и роли отсутствуют."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Код восстановления можно показать, скопировать или сохранить в файл. Без него восстановление зашифрованной базы невозможно. Храните код отдельно от ТСД."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Резервные копии: ежедневно (7), еженедельно (4), ежемесячно (3), плюс ручная. Копию можно сохранить в файл и восстановить с проверкой кода."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}" Margin="0" Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ЛОГИ И ВАЖНОЕ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="⋮ → «Логи»: список файлов, последний лог и ZIP-архив. Пароли, токены и ключи в логи не записываются."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="• Одна марка — только в одном коробе."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="• Ёмкость: «Стандарт» без ограничения или 12, 10, 5, 3."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="• Смешанный заказ разрешён."
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="• Перед удалением приложения сохраните копию и код восстановления."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Label Text="Версия 1.0"
                       Style="{StaticResource BodyLabel}"
                       HorizontalOptions="Center"
                       Margin="0,4,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3"
              Padding="8,4,8,12"
              BackgroundColor="{StaticResource Background}">
            <Button Text="Назад"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding BackCommand}" />
        </Grid>

    </Grid>

</ContentPage>
