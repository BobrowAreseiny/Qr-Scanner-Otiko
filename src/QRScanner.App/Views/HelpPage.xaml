<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.HelpPage"
             Title="Справка"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Справка"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,4,16,28" Spacing="0">

                <Label Text="НАЗНАЧЕНИЕ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Приложение предназначено для учёта коробов и марок, отгрузки заказов и обмена данными с 1С. Работа выполняется сканером ТСД и клавишами 1–4, 0."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="ГЛАВНЫЙ ЭКРАН"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="На главном экране четыре крупные плитки: «Агрегация», «Отгрузка», «История», «Настройки». Нажмите на плитку, чтобы открыть раздел."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="1 — Агрегация, 2 — Отгрузка, 3 — История, 4 — Настройки, 0 — Выход."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Верхнее меню (⋮): Логи, О программе. Внизу главного экрана — «Справка» и «Выход»."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="КЛАВИШИ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="1 — основное действие: сохранить, удалить марку, отправить заказ."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="2 — дополнительное действие: QR-код короба или возврат заказа на склад."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="3 — история заказов на главном экране; в карточке заказа — отправка в 1С."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="4 — настройки на главном экране."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="0 — назад или выход с главного экрана."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="В полях ввода клавиши работают как обычные цифры и буквы. Сканер срабатывает независимо от экрана."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="АГРЕГАЦИЯ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="1. Создать короб"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Укажите название и ёмкость: «Стандарт» без ограничения или 12, 10, 5, 3 марки. Сканируйте марки товара. Нажмите «Сохранить»."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Одна марка не может находиться в двух коробах. Повторное сканирование уже добавленной марки блокируется. Для ёмкости 12/10/5/3 действует ограничение; в режиме «Стандарт» лимита нет."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="2. Короба"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Нажмите на карточку короба, чтобы открыть состав. Красная корзина удаляет короб вместе с марками. Длинные названия переносятся и не мешают кнопкам."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="3. Поиск"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Отсканируйте марку. Приложение найдёт короб, в котором она лежит, и покажет данные. Клавиша 1 удаляет марку из короба."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="ОТГРУЗКА"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Новый заказ"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Сканируйте короб — в заказ добавятся все его марки. Можно добавлять отдельные марки: смешанный заказ разрешён. Проверка дублей выполняется автоматически."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Нажмите 1, чтобы сохранить заказ. Файл .txt создаётся в папке Download/Otiko — её видно в проводнике Android и по USB. Если настроен API 1С, заказ отправляется сразу; при ошибке он остаётся в очереди."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Повторно сохранить файл старого заказа можно в истории: откройте заказ и нажмите «Экспорт файла»."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="История заказов"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="В списке отображаются дата, количество марок, статус склада и статус 1С. В карточке заказа доступны:"
                       Style="{StaticResource BodyLabel}" />
                <Label Text="1. Отгрузить — отметить заказ отправленным."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="2. Вернуть на склад — снять статус отправки с коробов."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="3. Отправить в 1С — повторная отправка."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Удаление заказа не удаляет короба и марки. Короба остаются на складе, статус «Отгружен» снимается."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="QR-КОД КОРОБА"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="На экране короба нажмите «QR». Выберите «Сохранить в файл» или «Поделиться». PNG содержит QR-код с ID короба и название снизу. Длинное название переносится до трёх строк и при необходимости сокращается."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Сохранение работает через системный выбор файла: Downloads, USB, облако. Файл можно отправить в почту или мессенджер."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="НАСТРОЙКИ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Электронный знак (Datamark)"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Укажите сервер, логин и пароль один раз и нажмите «Сохранить». При следующих запусках приложение входит автоматически и обновляет сессию. Сменить логин или пароль можно в любой момент."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Без авторизации Электронного знака (Datamark) марки не добавляются: приложение покажет сообщение и предложит перейти в настройки."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="1С"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Настройте адрес API, пути отправки и проверки, склад, таймаут и авторизацию: без авторизации, Bearer-токен или Basic. Для локального сервера можно разрешить самоподписанный сертификат."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Кнопка «Проверить подключение» проверяет связь. «Отправить ожидающие заказы» повторно отправляет заказы, которые не ушли в 1С."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="Файлы"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="В настройках есть очистка старых файлов: удаляются .txt и .png старше 30 дней из Download/Otiko. Короба, марки и заказы не затрагиваются."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="ФАЙЛ ОТГРУЗКИ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Файл .txt создаётся в папке Download/Otiko: одна полная марка на строку, UTF-8 без BOM. Папку видно в проводнике Android и по USB. Внутренние GS-разделители кода сохраняются, служебный символ «è» в начало не добавляется."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Если настроен API 1С, заказ отправляется сразу; при ошибке он остаётся в очереди для повторной отправки."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Повторный экспорт доступен в истории заказа. Старые файлы можно удалить в настройках: «Очистить старые файлы»."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="БЕЗОПАСНОСТЬ И ДАННЫЕ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Локальная база шифруется SQLCipher. PIN и роли отсутствуют: настройки доступны любому пользователю ТСД."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Код восстановления"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="В настройках можно показать код, скопировать его или сохранить в файл. Без кода восстановление зашифрованной базы невозможно. Храните код отдельно от ТСД."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Резервные копии"
                       Style="{StaticResource ListNameLabel}" />
                <Label Text="Приложение создаёт зашифрованные копии: ежедневно (хранится 7), еженедельно (4), ежемесячно (3), плюс ручная копия. Копию можно сохранить в файл и восстановить с проверкой кода."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="Данные удаляются только вручную. Автоматической очистки коробов, марок и заказов нет; старые файлы можно удалить в настройках."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="ЛОГИ"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="Откройте ⋮ → Логи. На экране отображаются файлы логов и последний лог. Кнопка «Поделиться логами» создаёт ZIP-архив."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="В логи не записываются пароли, токены и ключи."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="ВАЖНО"
                       Style="{StaticResource SectionHeaderLabel}" />
                <Label Text="• Одна марка — только в одном коробе."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="• Ёмкость короба: «Стандарт» без ограничения или 12, 10, 5, 3."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="• Смешанный заказ разрешён."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="• При удалении заказа короба и марки остаются на складе."
                       Style="{StaticResource BodyLabel}" />
                <Label Text="• Перед удалением приложения сохраните резервную копию и код восстановления."
                       Style="{StaticResource BodyLabel}" />

                <Label Text="Версия 1.0"
                       Style="{StaticResource BodyLabel}"
                       Margin="0,18,0,0" />

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="3"
                             Padding="0,4,0,12"
                             Spacing="8"
                             BackgroundColor="{StaticResource Background}">
            <Button Text="Назад"
                    Style="{StaticResource MenuButtonStyle}"
                    HeightRequest="52"
                    Margin="7,0"
                    Command="{Binding BackCommand}" />
        </VerticalStackLayout>

    </Grid>

</ContentPage>
