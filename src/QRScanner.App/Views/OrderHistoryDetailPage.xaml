<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.OrderHistoryDetailPage"
             x:Name="Root"
             Title="Заказ"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="{Binding Title}"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,16,16,24"
                                 Spacing="14">

                <Border Style="{StaticResource CardStyle}">
                    <VerticalStackLayout Spacing="4">
                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Дата"
                                   Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding DateText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Марок"
                                   Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CountText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Статус"
                                   Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding StatusText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="1С"
                                   Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding OneCStatusText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Отправить в 1С"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="52"
                        IsVisible="{Binding CanSendTo1C}"
                        Command="{Binding SendTo1CCommand}" />

                <Label Text="Марки"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}"
                                     Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <VerticalStackLayout Spacing="2">
                                    <Label Text="{Binding DisplayTitle}"
                                           Style="{StaticResource ListNameLabel}" />
                                    <Label Text="{Binding SourceText}"
                                           Style="{StaticResource ListMetaLabel}" />
                                    <Label Text="{Binding ProductDetails}"
                                           Style="{StaticResource ListMetaLabel}" />
                                </VerticalStackLayout>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3"
              Padding="8,4,8,12"
              ColumnDefinitions="*,*,*"
              ColumnSpacing="8"
              BackgroundColor="{StaticResource Background}">
            <Button Text="Отправлено"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding ShipCommand}" />

            <Button Grid.Column="1"
                    Text="Вернуть"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    SemanticProperties.Description="Вернуть на склад"
                    Command="{Binding ReturnCommand}" />

            <Button Grid.Column="2"
                    Text="Назад"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding BackCommand}" />
        </Grid>

    </Grid>

</ContentPage>
