<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.AggregationPage"
             Title="Агрегация"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*"
          BackgroundColor="{StaticResource Background}">

        <controls:MenuHeader Grid.Row="0"
                             Title="Агрегация" />

        <ScrollView Grid.Row="1">
            <VerticalStackLayout Padding="0,20,0,0" Spacing="16">

                <Button Text="1. Создать короб"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding CreateCorobCommand}" />

                <Button Text="2. Короба"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenCorobsCommand}" />

                <Button Text="3. Информация"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenInfoCommand}" />

                <Button Text="4. Проверка GTIN"
                        Style="{StaticResource MenuButtonStyle}"
                        Command="{Binding OpenGtinCheckCommand}" />

                <BoxView Style="{StaticResource ThinDivider}"
                         Margin="0,7,0,0" />

                <Button Text="0. Назад"
                        Style="{StaticResource MenuButtonStyle}"
                        Margin="7,37,7,0"
                        Command="{Binding BackCommand}" />

                <BoxView HeightRequest="60" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
