<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.SettingsSectionPage"
             Title="{Binding SectionTitle}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="{Binding SectionTitle}"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,12,16,24" Spacing="12">

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowDatamark}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ЭЛЕКТРОННЫЙ ЗНАК (DATAMARK)"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Label Text="Сервер" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding Server, Mode=TwoWay}"
                                   Placeholder="https://api.datamark.by/" />
                        </Border>

                        <Label Text="Логин" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding Login, Mode=TwoWay}"
                                   Placeholder="Логин Электронного знака" />
                        </Border>

                        <Label Text="Пароль" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding Password, Mode=TwoWay}"
                                   IsPassword="{Binding IsPasswordHidden}"
                                   Placeholder="Пароль Электронного знака" />
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsPasswordVisible}"
                                    SemanticProperties.Description="Показать пароль" />
                            <Label Grid.Column="1"
                                   Text="Показать пароль"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              Margin="0,4,0,0">
                            <Button Text="Проверить"
                                    Style="{StaticResource CompactMenuButtonStyle}"
                                    Command="{Binding TestCommand}" />
                            <Button Grid.Column="1"
                                    Text="Сохранить"
                                    Style="{StaticResource CompactMenuButtonStyle}"
                                    Command="{Binding SaveCommand}" />
                        </Grid>

                        <Label Text="{Binding StatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Логин и пароль хранятся в защищённом хранилище Android."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowSmb}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="КОМПЬЮТЕР (SMB)"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Label Text="Сервер" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding SmbServer, Mode=TwoWay}"
                                   Placeholder="192.168.0.15" />
                        </Border>

                        <Label Text="Общая папка" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding SmbShare, Mode=TwoWay}"
                                   Placeholder="QRScanner" />
                        </Border>

                        <Label Text="Пользователь" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding SmbLogin, Mode=TwoWay}"
                                   Placeholder="BEAVER-JR\qrscanner" />
                        </Border>

                        <Label Text="Пароль" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding SmbPassword, Mode=TwoWay}"
                                   IsPassword="{Binding IsSmbPasswordHidden}"
                                   Placeholder="Пароль пользователя" />
                        </Border>

                        <Grid ColumnDefinitions="Auto,*" ColumnSpacing="8">
                            <Switch IsToggled="{Binding IsSmbPasswordVisible}"
                                    SemanticProperties.Description="Показать пароль SMB" />
                            <Label Grid.Column="1"
                                   Text="Показать пароль"
                                   FontSize="16"
                                   VerticalOptions="Center" />
                        </Grid>

                        <Grid ColumnDefinitions="*,*"
                              ColumnSpacing="8"
                              Margin="0,4,0,0">
                            <Button Text="Проверить"
                                    Style="{StaticResource CompactMenuButtonStyle}"
                                    Command="{Binding TestSmbCommand}" />
                            <Button Grid.Column="1"
                                    Text="Сохранить"
                                    Style="{StaticResource CompactMenuButtonStyle}"
                                    Command="{Binding SaveSmbCommand}" />
                        </Grid>

                        <Button Text="Импорт из файла"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding ImportSmbCommand}" />

                        <Label Text="Скопируйте QRScanner-access.txt в Download или в папку приложения по USB."
                               Style="{StaticResource BodyLabel}" />

                        <Label Text="{Binding SmbStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="Файлы: C:\QRScanner\Заказы и C:\QRScanner\QR-коды."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowSecurity}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="БЕЗОПАСНОСТЬ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Шифрование БД" Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="SQLCipher"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <BoxView Style="{StaticResource SettingRowSeparator}" />

                        <Label Text="Код восстановления"
                               Style="{StaticResource SettingLabel}" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="8">
                            <Button Text="Показать"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding ShowRecoveryCodeCommand}" />
                            <Button Grid.Column="1"
                                    Text="Копировать"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding CopyRecoveryCodeCommand}" />
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="Сохранить в файл"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding SaveRecoveryCodeCommand}" />
                        </Grid>

                        <Label Text="{Binding RecoveryCode}"
                               IsVisible="{Binding IsRecoveryCodeVisible}"
                               FontSize="16"
                               TextColor="{StaticResource TextPrimary}"
                               LineBreakMode="CharacterWrap" />

                        <Label Text="{Binding RecoveryStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowBackups}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="РЕЗЕРВНЫЕ КОПИИ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="{Binding LastBackupText}"
                               Style="{StaticResource BodyLabel}" />

                        <Grid ColumnDefinitions="*,*"
                              RowDefinitions="Auto,Auto"
                              ColumnSpacing="8"
                              RowSpacing="8">
                            <Button Text="Создать копию"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding CreateBackupCommand}" />
                            <Button Grid.Column="1"
                                    Text="В файл"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding SaveBackupCommand}" />
                            <Button Grid.Row="1"
                                    Grid.ColumnSpan="2"
                                    Text="Восстановить из файла"
                                    Style="{StaticResource SmallButtonStyle}"
                                    Command="{Binding RestoreBackupCommand}" />
                        </Grid>

                        <Label Text="{Binding BackupStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowFiles}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ФАЙЛЫ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />
                        <Label Text="Заказы: Download/Otiko/Заказы · QR: Download/Otiko/QR-коды"
                               Style="{StaticResource SettingLabel}" />
                        <Label Text="Очистка удаляет только .txt и .png старше 30 дней. База, короба и марки не затрагиваются."
                               Style="{StaticResource BodyLabel}" />
                        <Button Text="Очистить старые файлы"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding CleanupFilesCommand}" />
                        <Label Text="{Binding FileCleanupStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowLegacy}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ПЕРЕНОС СТАРОЙ БАЗЫ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />
                        <Label Text="Файл barcode.db. Импорт только в пустую базу."
                               Style="{StaticResource BodyLabel}" />
                        <Button Text="Импортировать"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding ImportLegacyDatabaseCommand}" />
                        <Label Text="{Binding LegacyImportStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowUpdate}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Установленная версия"
                                   Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentVersionText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <Button Text="Проверить обновление"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding CheckUpdateCommand}" />

                        <Label Text="{Binding UpdateStatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                        <Label Text="На компьютере: C:\QRScanner\Обновления — файлы version.json и APK."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        IsVisible="{Binding ShowAbout}">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="О ПРОГРАММЕ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Версия" Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="{Binding CurrentVersionText}"
                                   Style="{StaticResource SettingValueLabel}" />
                        </Grid>

                        <BoxView Style="{StaticResource SettingRowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Grid.GestureRecognizers>
                                <TapGestureRecognizer Command="{Binding ShowAboutCommand}" />
                            </Grid.GestureRecognizers>
                            <Label Text="О программе" Style="{StaticResource SettingLabel}" />
                            <Label Grid.Column="1"
                                   Text="›"
                                   Style="{StaticResource SettingValueLabel}"
                                   FontSize="22" />
                        </Grid>
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

    </Grid>

</ContentPage>
