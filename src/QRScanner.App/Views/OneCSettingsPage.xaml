<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.OneCSettingsPage"
             Title="1С: подключение"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="1С: подключение"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,12,16,16" Spacing="12">

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ПОДКЛЮЧЕНИЕ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Label Text="Адрес API" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding BaseUrl, Mode=TwoWay}"
                                   Placeholder="http://server/1c" />
                        </Border>

                        <Label Text="Путь отправки заказов"
                               Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding OrdersPath, Mode=TwoWay}"
                                   Placeholder="/api/qrscanner/orders" />
                        </Border>

                        <Label Text="Путь проверки"
                               Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding HealthPath, Mode=TwoWay}"
                                   Placeholder="/api/qrscanner/health" />
                        </Border>
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="АВТОРИЗАЦИЯ"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,2" />

                        <Label Text="Способ" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Picker ItemsSource="{Binding AuthTypes}"
                                    SelectedItem="{Binding SelectedAuthType, Mode=TwoWay}" />
                        </Border>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding IsBearerAuth}">
                            <Label Text="Bearer-токен"
                                   Style="{StaticResource SettingLabel}" />
                            <Border BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="10,0">
                                <Entry Text="{Binding Token, Mode=TwoWay}"
                                       IsPassword="True"
                                       Placeholder="Токен" />
                            </Border>
                        </VerticalStackLayout>

                        <VerticalStackLayout Spacing="8"
                                             IsVisible="{Binding IsBasicAuth}">
                            <Label Text="Логин" Style="{StaticResource SettingLabel}" />
                            <Border BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="10,0">
                                <Entry Text="{Binding Login, Mode=TwoWay}"
                                       Placeholder="Пользователь 1С" />
                            </Border>

                            <Label Text="Пароль" Style="{StaticResource SettingLabel}" />
                            <Border BackgroundColor="{StaticResource Surface}"
                                    Stroke="{StaticResource Border}"
                                    StrokeThickness="1"
                                    StrokeShape="Rectangle"
                                    Padding="10,0">
                                <Entry Text="{Binding Password, Mode=TwoWay}"
                                       IsPassword="True"
                                       Placeholder="Пароль 1С" />
                            </Border>
                        </VerticalStackLayout>

                        <Label Text="Склад" Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding Warehouse, Mode=TwoWay}"
                                   Placeholder="Основной склад" />
                        </Border>

                        <Label Text="Таймаут, секунд"
                               Style="{StaticResource SettingLabel}" />
                        <Border BackgroundColor="{StaticResource Surface}"
                                Stroke="{StaticResource Border}"
                                StrokeThickness="1"
                                StrokeShape="Rectangle"
                                Padding="10,0">
                            <Entry Text="{Binding TimeoutSeconds, Mode=TwoWay}"
                                   Keyboard="Numeric"
                                   Placeholder="30" />
                        </Border>

                        <BoxView Style="{StaticResource SettingRowSeparator}" />

                        <Grid ColumnDefinitions="*,Auto">
                            <Label Text="Самоподписанный сертификат"
                                   Style="{StaticResource SettingLabel}" />
                            <Switch Grid.Column="1"
                                    IsToggled="{Binding AllowInvalidCertificate, Mode=TwoWay}" />
                        </Grid>

                        <Label Text="Только для локального сервера 1С. Снижает защиту соединения."
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

                <Border Style="{StaticResource CardStyle}"
                        Margin="0"
                        Padding="14">
                    <VerticalStackLayout Spacing="8">
                        <Label Text="ПРОВЕРКА И ОБМЕН"
                               Style="{StaticResource SectionHeaderLabel}"
                               Margin="0,0,0,0" />

                        <Button Text="Проверить подключение"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding TestCommand}" />

                        <Button Text="Отправить ожидающие заказы"
                                Style="{StaticResource CompactMenuButtonStyle}"
                                Command="{Binding SendPendingCommand}" />

                        <Label Text="{Binding StatusMessage}"
                               Style="{StaticResource BodyLabel}" />
                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3"
              Padding="8,4,8,12"
              ColumnDefinitions="*,*"
              ColumnSpacing="8"
              BackgroundColor="{StaticResource Background}">
            <Button Text="Сохранить"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding SaveCommand}" />
            <Button Grid.Column="1"
                    Text="Назад"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding BackCommand}" />
        </Grid>

    </Grid>

</ContentPage>
