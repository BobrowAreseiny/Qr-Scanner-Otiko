<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:controls="clr-namespace:QRScanner.App.Controls"
             x:Class="QRScanner.App.Views.OrderPage"
             x:Name="Root"
             Title="Новый заказ"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="40,3,*,Auto"
          BackgroundColor="{StaticResource Background}">

        <controls:AppToolbar Grid.Row="0"
                             Title="Новый заказ"
                             ShowBack="True"
                             BackCommand="{Binding BackCommand}" />

        <BoxView Grid.Row="1"
                 Style="{StaticResource ThinDivider}" />

        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="16,16,16,32" Spacing="14">

                <Label Text="Название файла"
                       Style="{StaticResource SectionHeaderLabel}"
                       Margin="0,0,0,0" />

                <Border BackgroundColor="{StaticResource Surface}"
                        Stroke="{StaticResource Border}"
                        StrokeThickness="1"
                        StrokeShape="Rectangle"
                        Padding="8,0">
                    <Entry Text="{Binding Name, Mode=TwoWay}"
                           Placeholder="Название заказа" />
                </Border>

                <Label Text="Файл .txt сохранится в Download/Otiko."
                       Style="{StaticResource BodyLabel}"
                       Margin="2,-6,0,0" />

                <Grid ColumnDefinitions="*,Auto">
                    <Label Text="Отсканировано"
                           Style="{StaticResource SettingLabel}" />
                    <Label Grid.Column="1"
                           Text="{Binding CountText}"
                           Style="{StaticResource SettingValueLabel}" />
                </Grid>

                <BoxView Style="{StaticResource SettingRowSeparator}" />

                <Label Text="Сканируйте короб или марку товара"
                       Style="{StaticResource BodyLabel}" />

                <Label Text="{Binding StatusMessage}"
                       Style="{StaticResource BodyLabel}" />

                <Button Text="Войти в настройки"
                        Style="{StaticResource MenuButtonStyle}"
                        HeightRequest="52"
                        Margin="0,6,0,0"
                        IsVisible="{Binding IsAuthRequired}"
                        Command="{Binding OpenSettingsCommand}" />

                <VerticalStackLayout BindableLayout.ItemsSource="{Binding Lines}"
                                     Spacing="0">
                    <BindableLayout.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource CardStyle}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">

                                    <VerticalStackLayout Spacing="2">
                                        <Label Text="{Binding DisplayTitle}"
                                               Style="{StaticResource ListNameLabel}" />
                                        <Label Text="{Binding ProductDetails}"
                                               Style="{StaticResource ListMetaLabel}" />
                                    </VerticalStackLayout>

                                    <ImageButton Grid.Column="1"
                                                 Source="trash.svg"
                                                 Style="{StaticResource SubtleImageButtonStyle}"
                                                 SemanticProperties.Description="Удалить марку"
                                                 Command="{Binding Path=BindingContext.DeleteLineCommand, Source={x:Reference Root}}"
                                                 CommandParameter="{Binding}" />
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </BindableLayout.ItemTemplate>
                </VerticalStackLayout>

            </VerticalStackLayout>
        </ScrollView>

        <Grid Grid.Row="3"
              Padding="8,4,8,12"
              ColumnDefinitions="*,*"
              ColumnSpacing="8"
              BackgroundColor="{StaticResource Background}">
            <Button Text="Сохранить"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding SaveCommand}" />

            <Button Grid.Column="1"
                    Text="Назад"
                    Style="{StaticResource CompactMenuButtonStyle}"
                    Command="{Binding BackCommand}" />
        </Grid>

    </Grid>

</ContentPage>
